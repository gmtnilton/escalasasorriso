<?xml version="1.0" encoding="utf-8"?>
<!-- Regras de backup/transferência de dados do Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
